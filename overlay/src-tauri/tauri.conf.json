{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveChat Overlay",
  "version": "0.2.1",
  "identifier": "me.popcom.livechat.overlay",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http: https:; media-src 'self' data: blob: http: https:; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "LiveChat Overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "fullscreen": false,
        "focus": false,
        "focusable": false,
        "visible": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "settings",
        "title": "LiveChat — Paramètres",
        "url": "settings.html",
        "width": 500,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["French", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzQUMyMTZGMDZFNEMzNzkKUldSNXcrUUdieUdzVThVbTlXYm1TOFZaa3NpNS9FZW5wV2NGNlViWWtrNW5HUlhSbTdxSjk5Qm8K",
      "endpoints": [
        "https://github.com/Kwickos/livechat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
